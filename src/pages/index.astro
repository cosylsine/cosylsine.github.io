---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Publication from '../components/Publication.astro';
import Arrow from '../components/Arrow.astro';
import { profile, research, news } from '../data/profile';
import { publications } from '../data/publications';
import { projects } from '../data/projects';
---
<BaseLayout>
  <Header/>
  <main id="main" class="container">
    <section id="home" class="hero" aria-labelledby="research-statement">
      <div class="identity">
        <div class="monogram" aria-hidden="true">Jx<span class="monogram-rule"></span></div>
        <p class="identity-name">{profile.name}<span lang="zh-CN">{profile.chineseName}</span></p>
        <p class="identity-role">{profile.role}</p>
        <p class="identity-school">{profile.institution}</p>
        <a class="identity-github" href={profile.github}>GitHub<Arrow diagonal/></a>
      </div>
      <div class="hero-content">
        <h1 id="research-statement">Information retrieval<br class="desktop-break"/> for LLM agents.</h1>
        <div id="about" class="hero-bio">
          <p>Hi, I’m Jiaxin Xu, a master’s student at <span class="nowrap">HIT Shenzhen</span>, advised by <a href={profile.advisor.url}>{profile.advisor.name}</a>.</p>
          <p>I study how agents find the information they need—with a focus on efficient reranking, agent-oriented evaluation, and long-horizon memory retrieval.</p>
          <p class="hero-note">Turning research ideas into reproducible benchmarks, practical models, and open-source tools.</p>
        </div>
        <div class="hero-actions">
          <a class="button-primary" href="#publications">View publications<Arrow/></a>
          <a class="button-text" href="#contact">Get in touch<Arrow diagonal/></a>
        </div>
      </div>
    </section>

    <div class="research-news">
      <section id="research" class="research" aria-labelledby="research-heading">
        <h2 id="research-heading">Research interests</h2>
        <div class="research-list">{research.map(item => <div class="research-item"><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
      </section>
      <section class="news" aria-labelledby="news-heading">
        <h2 id="news-heading">Recent news</h2>
        <ul>{news.map(item => <li><time datetime={item.date}>{item.display}</time><a href={item.url}>{item.text}</a></li>)}</ul>
      </section>
    </div>

    <section id="publications" class="section publications" aria-labelledby="publications-heading">
      <div class="section-heading"><h2 id="publications-heading">Selected publications</h2><p>Papers, models, and benchmarks</p></div>
      <div class="publication-list">{publications.map(paper => <Publication paper={paper}/>)}</div>
    </section>

    <section id="projects" class="section projects" aria-labelledby="projects-heading">
      <div class="section-heading"><h2 id="projects-heading">Open source & engineering</h2></div>
      <p class="section-intro">Research made usable. My engineering contributions across these team collaborations include evaluation workflows, training infrastructure, and model integration.</p>
      <div class="project-list">{projects.map(project => <article class="project">
        <p class="project-name">{project.project}</p>
        <div class="project-description"><h3><a href={project.url}>{project.name}<Arrow diagonal/></a></h3><p>{project.description}</p></div>
        <p class="project-resource">{project.resource}</p>
      </article>)}</div>
    </section>

    <section class="section education" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <div class="education-detail"><div><h3>{profile.institution}</h3><p>Master’s student in {profile.degree}</p><p class="education-advisor">Advisor: <a href={profile.advisor.url}>{profile.advisor.name}</a></p></div><p class="education-dates">{profile.educationDates}</p></div>
    </section>

    <section id="contact" class="section contact" aria-labelledby="contact-heading">
      <div class="contact-copy"><h2 id="contact-heading">Let’s talk research.</h2><p>I’m happy to connect with researchers and practitioners working on information retrieval, reranking, and LLM agents.</p></div>
      <div class="contact-links">
        {profile.emails.map(email => <div class="email-row"><a href={`mailto:${email}`}>{email}</a><button class="copy-email" type="button" data-email={email} aria-label={`Copy ${email}`} hidden><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="7" y="7" width="9" height="10" rx="1"/><path d="M12 7V3H3v10h4"/></svg><span class="copy-label">Copy</span></button></div>)}
        <a class="contact-github" href={profile.github}>GitHub / cosylsine<Arrow diagonal/></a>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>
    </section>
  </main>
  <footer class="container site-footer"><p>© {new Date().getFullYear()} Jiaxin Xu</p><a href="#home">Back to top<svg class="arrow" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5"/></svg></a></footer>
</BaseLayout>
<script>
  const status = document.querySelector<HTMLElement>('.copy-status');
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email || '');
        if (status) status.textContent = `Copied ${button.dataset.email}.`;
      } catch {
        if (status) status.textContent = 'Select the email address to copy it, or click it to send an email.';
      }
    });
  });
</script>
