---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import { profile } from '../data/profile';
import { publications } from '../data/publications';
---
<BaseLayout>
  <main id="main" class="page">
    <header class="profile" aria-labelledby="name-heading">
      <h1 id="name-heading">{profile.name}<span lang="zh-CN">{profile.chineseName}</span></h1>
      <img class="profile-image" src="/images/profile.webp" alt="Jiaxin Xu’s chosen profile image" width="480" height="584" decoding="async" fetchpriority="high"/>
      <div class="bio">
        <p>I’m a master’s student in {profile.degree} at {profile.institution}, advised by <a href={profile.advisor.url}>{profile.advisor.name}</a>.</p>
        <p>My research focuses on information retrieval for LLM agents, particularly efficient reranking, agent-oriented evaluation, and long-horizon memory retrieval.</p>
      </div>
      <ul class="contact-links" aria-label="Contact and profiles">
        <li><a href={`mailto:${profile.emails[0]}`}>{profile.emails[0]}</a></li>
        <li><a href={`mailto:${profile.emails[1]}`} aria-label={`Email ${profile.emails[1]}`}>Email (163)</a></li>
        <li><a href={profile.github}>GitHub</a></li>
      </ul>
    </header>

    <section id="publications" aria-labelledby="publications-heading">
      <h2 id="publications-heading">Publications</h2>
      <div class="publication-list">{publications.map(paper => <Publication paper={paper}/>)}</div>
    </section>
    <section class="education" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <p class="education-school">{profile.institution}</p>
      <ul class="education-list">
        <li><span>Master’s studies in {profile.degree}</span><span class="education-date">{profile.educationDates}</span></li>
        <li><span>Undergraduate studies in {profile.undergraduateMajor}</span><span class="education-date">{profile.undergraduateDates}</span></li>
      </ul>
    </section>
    <section id="honors" class="honors" aria-labelledby="honors-heading">
      <h2 id="honors-heading">Honors</h2>
      <ul class="honors-list">
        {profile.honors.map(honor => <li><span>{honor.title}</span><span class="honor-year">{honor.year}</span></li>)}
      </ul>
    </section>
    <footer class="site-footer"><p>© {new Date().getFullYear()} {profile.name}</p></footer>
  </main>
</BaseLayout>
