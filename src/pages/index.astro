---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Publication from '../components/Publication.astro';
import Arrow from '../components/Arrow.astro';
import { profile, research, news } from '../data/profile';
import { publications } from '../data/publications';
import { projects } from '../data/projects';
---
<BaseLayout>
  <Header/>
  <main id="main">
    <section id="home" class="hero container" aria-labelledby="name-heading">
      <div class="hero-identity">
        <div class="name-line"><h1 id="name-heading">Jiaxin Xu</h1><span class="chinese-name" lang="zh-CN">许佳鑫</span></div>
        <p class="hero-role">Master’s student at <span class="nowrap">HIT Shenzhen</span></p>
        <p class="hero-statement">Information retrieval<br/>for LLM agents.</p>
        <div class="hero-actions">
          <a class="button-primary" href="#publications">Explore my research<Arrow/></a>
          <a class="button-text" href="#contact">Get in touch<Arrow diagonal/></a>
        </div>
      </div>
      <div id="about" class="hero-about">
        <p class="intro">I study how agents find<br class="wide-break"/> the information they need.</p>
        <p>Hi! I’m Jiaxin, a master’s student at Harbin Institute of Technology, Shenzhen, advised by <a href={profile.advisor.url}>{profile.advisor.name}</a>.</p>
        <p>My work spans efficient reranking, agent-oriented evaluation, and long-horizon memory retrieval. I enjoy turning research ideas into reproducible benchmarks and practical, open-source models.</p>
        <div class="hero-socials"><a href={profile.github}>GitHub<Arrow diagonal/></a><a href="#contact">Email<Arrow diagonal/></a></div>
      </div>
    </section>

    <section class="news container" aria-labelledby="news-heading">
      <h2 id="news-heading">Recent news</h2>
      <ul>{news.map(item => <li><time datetime={item.date}>{item.display}</time><a href={item.url}>{item.text}</a></li>)}</ul>
    </section>

    <section id="publications" class="section publications container" aria-labelledby="publications-heading">
      <div class="section-heading"><div><h2 id="publications-heading">Selected publications</h2><p>Retrieval, from models to agent capabilities.</p></div><span class="section-aside">Papers & public resources</span></div>
      <div class="publication-list">{publications.map((paper, index) => <Publication paper={paper} featured={index === 0}/>)}</div>
    </section>

    <section id="research" class="research-band" aria-labelledby="research-heading">
      <div class="container research-layout">
        <div class="research-intro"><h2 id="research-heading">What makes retrieval<br/>useful to an agent?</h2><p>My research connects the models that find information with the systems that need it.</p></div>
        <div class="research-list">{research.map(item => <div class="research-item"><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
      </div>
    </section>

    <section id="projects" class="section projects container" aria-labelledby="projects-heading">
      <div class="section-heading"><div><h2 id="projects-heading">Beyond the paper</h2><p>Open source & engineering</p></div><a class="section-link" href={profile.github}>Find me on GitHub<Arrow diagonal/></a></div>
      <p class="section-intro">Research is a team effort. These are the evaluation tools, model releases, and benchmark resources I have contributed to.</p>
      <div class="project-list">{projects.map(project => <article class="project">
        <div class="project-identity"><p class="project-name">{project.project}</p><p class="project-resource">{project.resource}</p></div>
        <div class="project-description"><h3><a href={project.url}>{project.name}<Arrow diagonal/></a></h3><p>{project.description}</p></div>
      </article>)}</div>
    </section>

    <section class="section education container" aria-labelledby="education-heading">
      <div class="education-heading"><h2 id="education-heading">Education</h2><p>Harbin Institute of Technology,<br/>Shenzhen</p></div>
      <div class="education-list">
        <article class="education-entry"><div class="education-label"><h3>Master’s studies</h3><span>{profile.educationDates}</span></div><p>{profile.degree}</p><p class="education-advisor">Advised by <a href={profile.advisor.url}>{profile.advisor.name}</a></p></article>
        <article class="education-entry"><div class="education-label"><h3>Undergraduate studies</h3></div><p>{profile.undergraduateMajor}</p><p class="education-school">{profile.institution}</p></article>
      </div>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-heading">
      <div class="container contact-layout">
        <div class="contact-copy"><h2 id="contact-heading">Let’s talk research.</h2><p>For research discussions, shared ideas,<br class="wide-break"/> and potential collaborations.</p></div>
        <div class="contact-links">
          {profile.emails.map(email => <div class="email-row"><a href={`mailto:${email}`}>{email}</a><button class="copy-email" type="button" data-email={email} aria-label={`Copy ${email}`} hidden><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="7" y="7" width="9" height="10" rx="1"/><path d="M12 7V3H3v10h4"/></svg><span class="copy-label">Copy</span></button></div>)}
          <a class="contact-github" href={profile.github}>GitHub / cosylsine<Arrow diagonal/></a>
          <p class="copy-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>
  <footer class="container site-footer"><p>© {new Date().getFullYear()} Jiaxin Xu<span lang="zh-CN">许佳鑫</span></p><a href="#home">Back to top<svg class="arrow" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5"/></svg></a></footer>
</BaseLayout>
<script>
  const status = document.querySelector<HTMLElement>('.copy-status');
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email || '');
        if (status) status.textContent = `Copied ${button.dataset.email}.`;
      } catch {
        if (status) status.textContent = 'Select the email address to copy it, or click it to send an email.';
      }
    });
  });
</script>
