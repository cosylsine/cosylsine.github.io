---
import sansFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { profile } from '../data/profile';
const title = 'Jiaxin Xu | Information Retrieval & LLM Agents';
const description = 'Jiaxin Xu is a master’s student at HIT Shenzhen researching information retrieval for LLM agents, efficient reranking, and long-horizon memory retrieval.';
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name,
  alternateName: profile.chineseName, url: profile.site, sameAs: [profile.github],
  jobTitle: profile.role,
  affiliation: { '@type': 'CollegeOrUniversity', name: profile.institution },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.institution },
  knowsAbout: ['Information Retrieval', 'Reranking', 'LLM Agents', 'Memory Retrieval'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#ffffff"/>
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={profile.site}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={profile.site}/>
    <meta property="og:image" content={`${profile.site}social-preview.png`}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Jiaxin Xu — Information retrieval for LLM agents"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={`${profile.site}social-preview.png`}/>
    <script type="application/ld+json" set:html={JSON.stringify(person)}/>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot/>
  </body>
</html>
