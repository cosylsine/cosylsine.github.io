---
import type { Publication } from '../data/publications';
import { profile } from '../data/profile';
interface Props { paper: Publication; }
const { paper } = Astro.props;
---
<article class="publication" aria-labelledby={`paper-${paper.id}`}>
  <a class="paper-thumbnail" href={paper.image.src} target="_blank" aria-label={`View figure: ${paper.figureCaption}`}>
    <img src={paper.image.src} alt={paper.image.alt} width={paper.image.width} height={paper.image.height} loading="lazy" decoding="async"/>
  </a>
  <div class="paper-info">
    <h3 id={`paper-${paper.id}`}><a href={paper.links[0].url}>{paper.title}</a></h3>
    <p class="authors">{paper.authors.map((author, index) => <>{index > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}</>)}</p>
    <p class="venue">{paper.venue}{paper.venue === 'Preprint' && `, ${paper.year}`}</p>
    <p class="paper-description">{paper.description}</p>
    <ul class="resource-links" aria-label={`Resources for ${paper.id.toUpperCase()}`}>
      {paper.links.map(link => <li><a href={link.url}>{link.label}</a></li>)}
      <li class="mobile-figure"><a href={paper.image.src} target="_blank" aria-label={`View figure: ${paper.figureCaption}`}>Figure</a></li>
    </ul>
  </div>
</article>
