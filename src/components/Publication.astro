---
import Arrow from './Arrow.astro';
import type { Publication } from '../data/publications';
import { profile } from '../data/profile';
interface Props { paper: Publication; featured?: boolean; }
const { paper, featured = false } = Astro.props;
---
<article class:list={['publication', `publication-${paper.id}`, { 'publication-featured': featured }]} aria-labelledby={`paper-${paper.id}`}>
  <figure class="research-figure">
    <a class="figure-link" href={paper.image.src} target="_blank" aria-label={`Open full-size ${paper.figureCaption}`}>
      <img src={paper.image.src} alt={paper.image.alt} width={paper.image.width} height={paper.image.height} loading="lazy" decoding="async"/>
      <span class="figure-expand" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M12 3h5v5M17 3l-5 5M8 17H3v-5m0 5 5-5"/></svg></span>
    </a>
    <figcaption><span>{paper.figureCaption}</span><a href={paper.image.source}>Source<Arrow diagonal/></a></figcaption>
  </figure>
  <div class="publication-content">
    <h3 id={`paper-${paper.id}`}><a href={paper.links[0].url}>{paper.title}</a></h3>
    <p class="authors">{paper.authors.slice(0, 3).map((author, index) => <>{index > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}</>)}, et al.</p>
    <div class="publication-meta"><p class="venue"><span class:list={['venue-name', { 'conference-venue': paper.venue !== 'Preprint' }]}>{paper.venue}</span>{paper.venue === 'Preprint' && <span>{paper.year}</span>}</p><details class="all-authors">
      <summary><svg class="author-toggle" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10"/><path class="author-toggle-vertical" d="M8 3v10"/></svg>All authors</summary>
      <p>{paper.authors.map((author, index) => <>{index > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}</>)}</p>
    </details></div>
    <p class="paper-description">{paper.description}</p>
    <ul class="resource-links" aria-label={`Resources for ${paper.id.toUpperCase()}`}>
      {paper.links.map(link => <li><a href={link.url}>{link.label}<Arrow diagonal/></a></li>)}
    </ul>
  </div>
</article>
